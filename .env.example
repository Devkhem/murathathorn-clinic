# Public — safe to expose to the browser. RLS is what protects the data, not these values.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only — never import this into a "use client" file. Used for HN generation,
# signed URL issuance, and any other server action that must bypass RLS deliberately.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional: real Thai ID card OCR via Claude's vision API. Without this, lib/ocr
# falls back to a manual-entry stub so the registration flow still works
# end-to-end in dev. Get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Optional override — defaults to "claude" if ANTHROPIC_API_KEY is set, else "manual".
# OCR_PROVIDER=claude
