# Public — safe to expose to the browser. RLS is what protects the data, not these values.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only — never import this into a "use client" file. Used for HN generation,
# signed URL issuance, and any other server action that must bypass RLS deliberately.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional: real OCR provider credentials. Without these, lib/ocr falls back to a
# manual-entry stub so the registration flow still works end-to-end in dev.
# OCR_PROVIDER=typhoon
# OCR_API_KEY=
